doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Add a Dragon
        a(href="/") Return to the homepage
        form(action="/update-cobj" method="POST")
            label(for="name") Name
            input(type="text" id="name" name="name" required)
            label(for="damage_type") Damage Type
            select(name="damage_type" id="damage_type"  required)
                option(value="acid") Acid
                option(value="cold") Cold
                option(value="fire") Fire
                option(value="lightning") Lightning
                option(value="poison") Poison
            label(for="mm_page") MM Page
            input(type="number" id="mm_page" name="mm_page")
            button(type="submit") Create Dragon
